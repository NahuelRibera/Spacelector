# Copy this file to .env and fill in what you need. Nothing here is required to run the app
# locally with `bundle exec rails server` — sign up with email/password and local disk storage
# both work with zero configuration. These only matter once you want optional features or a
# production deployment; see README.md and docs/DEPLOYMENT.md.

# --- Optional: "Sign in with Google" ---
# Without these, the Google button on the sign-in page just won't work; email/password still does.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Production only: image storage (do not set these locally) ---
# Local development and the test suite use local disk automatically; production needs an
# S3-compatible bucket (Cloudflare R2, or AWS S3) since Render's filesystem is not persistent.
# See docs/DEPLOYMENT.md for how to get these values.
# ACTIVE_STORAGE_SERVICE=amazon
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# S3_BUCKET_NAME=
# S3_ENDPOINT=

# --- Production only ---
# SECRET_KEY_BASE=   # generate with `bin/rails secret`
# APP_HOST=          # your domain, used to build links in emails

# --- Optional: outgoing email (password reset) ---
# Without these, "forgot password" no-ops instead of crashing; nothing is actually emailed.
# SMTP_ADDRESS=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
