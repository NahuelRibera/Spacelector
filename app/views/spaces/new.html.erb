<h1>New Space</h1>

<%= form_with model: @space, url: spaces_path, local: true do |form| %>
  <% if @space.parent_space_id %>
    <%= form.hidden_field :parent_space_id %>
  <% end %>
  <div class="field">
    <%= form.label :name, "Space Name" %>
    <%= form.text_field :name, required: true %>
  </div>
  <%= form.submit "Create Space" %>
<% end %>

<%= link_to 'Back', spaces_path %>
