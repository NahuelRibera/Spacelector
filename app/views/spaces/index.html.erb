<section id="content" class="set">
  <% if user_signed_in? %>
    <div class="header">
      <h1>Spaces</h1>
      <%= link_to '+ New', new_space_path, class: 'new' %>
    </div>

    <ul class="space-list">
      <% @spaces.each do |space| %>
        <li>
          <div class="space-info" style="cursor: pointer; position: relative;">
            <!-- This div becomes the clickable area, excluding the delete button -->
            <%= link_to space.name, space_path(space), class: "space-link" %>
            <%= form_with url: space_path(space), method: :delete, class: "delete-form" do |form| %>
              <%= form.submit 'X', onclick: "return confirm('Are you sure you want to delete this space?')", class: 'delete-space', style: "position: absolute; right: 10px; top: 50%; transform: translateY(-50%);" %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>

    <script>
      document.addEventListener("DOMContentLoaded", function() {
        // Similar functionality as in the show view
        const spaceInfos = document.querySelectorAll('.space-info');

        spaceInfos.forEach(spaceInfo => {
          spaceInfo.addEventListener('click', function(event) {
            const spaceLink = this.querySelector('.space-link');
            if (spaceLink) {
              window.location.href = spaceLink.href;
            }
          });
        });

        const deleteButtons = document.querySelectorAll('.delete-space');

        deleteButtons.forEach(deleteButton => {
          deleteButton.addEventListener('click', function(event) {
            event.stopPropagation(); // This prevents the click from bubbling up to the .space-info
            // The rest of the delete action remains unchanged
          });
        });
      });
    </script>
  <% else %>
  <%# /////////////////////////////////////////////////////////////////////// %>
  </section>
  <section id="content-home">
<div id="section1" class="hero">
  <div class="container">
    <div class="row">
      <!-- Image column -->
      <div class="col-md-6">
        <%= image_tag "boombbba.png", alt: "Showcase Image", class: "img-1" %>
      </div>
      <!-- Text and CTA column -->
      <div class="col-md-6">
        <div class="hero-content">
          <div class="logo-2">
            <%= image_tag "spacelector.png", class: "logo-image"%>
          </div>
          <h1>What are you looking for?</h1>

          <p>Manage your space to access your belongings. Take or upload a<br>picture, select spaces, add information.<strong> Find anything in seconds.</strong></p>
            <%= form_for "Login", url: omniauth_authorize_path(:user, :google_oauth2), method: :post, data: { turbo: "false" }, html: { class: "button_to" } do |f| %>
              <%= button_tag(type: 'submit', class: 'btn go-to') do %>
                Get Started
