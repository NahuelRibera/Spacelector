<section id="content" class="set">
  <% if user_signed_in? %>
    <div class="header">
      <h1>Spaces</h1>
      <%= link_to '+ New', new_space_path, class: 'new' %>
    </div>

    <ul class="space-list">
      <% @spaces.each do |space| %>
        <li>
          <div class="space-box">
            <%= link_to space_path(space) do %>
              <%= space.name %>
            <% end %>

            <%= form_with url: space_path(space), method: :delete, class: "delete-form" do |form| %>
              <%= form.submit 'X', onclick: "return confirm('Are you sure you want to delete this space?')", class: 'delete-space' %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>

    <script>
      document.addEventListener("DOMContentLoaded", function() {
        const deleteButtons = document.querySelectorAll(".delete-space");

        deleteButtons.forEach(button => {
          button.addEventListener("click", function(event) {
            const confirmationMessage = 'Are you sure you want to delete this space?';

            if (!confirm(confirmationMessage)) {
              event.preventDefault();
            }
          });
        });
      });
    </script>
  <% else %>
  </section>
  <section id="content">
<div class="hero">
  <div class="container">
    <div class="row align-items-center">
      <!-- Image column -->
      <div class="col-md-6">
        <%= image_tag "boombbba.png", alt: "Showcase Image", class: "img-fluid" %>
      </div>
      <!-- Text and CTA column -->
      <div class="col-md-6">
        <div class="hero-content">
          <div class="logo-2">
            <%= image_tag "spacelector.png", class: "logo-image"%>
          </div>
          <h1>Store and find your belongings fast, in one secure place</h1>
          <p>Store and find anything. Access to your space anytime, anywhere from your desktop and mobile devices. Find anything in seconds.</p>
            <%= form_for "Login", url: omniauth_authorize_path(:user, :google_oauth2), method: :post, data: { turbo: "false" }, html: { class: "button_to" } do |f| %>
              <%= button_tag(type: 'submit', class: 'btn btn-primary') do %>
                Get Started
              <% end %>
            <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Info Section - Text Left, Image Right -->
<div class="info-section bg-light">
  <div class="container">
    <div class="row align-items-center">
      <!-- Text column -->
      <div class="col-md-6">
        <h2>Get all the storage capacity you need</h2>
        <p>Google Workspace provides flexible storage options so you will always have enough space for your files. With centralized administration, data loss prevention, and Vault for Drive, you can easily manage users and file sharing to help meet data compliance needs.</p>
      </div>
      <!-- Image column -->
      <div class="col-md-6">
        <img src="path_to_your_image_right.jpg" alt="Storage Options" class="img-fluid">
      </div>
    </div>
  </div>
</div>

<!-- Info Section - Image Left, Text Right -->
<div class="info-section">
  <div class="container">
    <div class="row align-items-center">
      <!-- Image column -->
      <div class="col-md-6">
        <img src="path_to_your_image_left.jpg" alt="Find Quickly" class="img-fluid">
      </div>
      <!-- Text column -->
      <div class="col-md-6">
        <h2>Find what’s important before you've even searched</h2>
        <p>Drive uses Google AI to predict and surface what’s important for you in real-time. Drive recognizes important content, collaborators and events, using features like Quick Access and...</p>
      </div>
    </div>
  </div>
</div>

<!-- Feature Columns -->
<div class="feature-columns">
  <div class="container">
    <div class="row">
      <div class="col-md-4">
        <h2>Upload Images</h2>
        <p>Take photos of your space and upload them to create your digital inventory.</p>
      </div>
      <div class="col-md-4">
        <h2>Create Compartments</h2>
        <p>Easily draw and label compartments over your images to segment your space.</p>
      </div>
      <div class="col-md-4">
        <h2>Find Items Quickly</h2>
        <p>Our visual guides help you locate your items without the guesswork.</p>
      </div>
    </div>
  </div>
</div>

<!-- Hero Section -->
<div class="hero-section">
  <div class="container">
    <div class="row">
      <div class="col-12">
        <h1>Manage Your Space With Ease</h1>
        <p>Our app transforms your physical storage into an easily navigable digital space.</p>
        <%= form_for "Login", url: omniauth_authorize_path(:user, :google_oauth2), method: :post, data: { turbo: "false" }, html: { class: "button_to" } do |f| %>
          <%= button_tag(type: 'submit', class: 'btn btn-primary') do %>
            Get Started
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
  <% end %>
</section>
