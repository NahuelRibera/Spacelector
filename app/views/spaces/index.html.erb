<section id="content" class="set">
  <% if user_signed_in? %>
    <div class="header">
      <h1>Spaces</h1>
      <%= link_to '+ New', new_space_path, class: 'new' %>
    </div>

    <ul class="space-list">
      <% @spaces.each do |space| %>
        <li>
          <div class="space-box">
            <%= link_to space_path(space) do %>
              <%= space.name %>
            <% end %>

            <%= form_with url: space_path(space), method: :delete, class: "delete-form" do |form| %>
              <%= form.submit 'X', onclick: "return confirm('Are you sure you want to delete this space?')", class: 'delete-space' %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>

    <script>
      document.addEventListener("DOMContentLoaded", function() {
        const deleteButtons = document.querySelectorAll(".delete-space");

        deleteButtons.forEach(button => {
          button.addEventListener("click", function(event) {
            const confirmationMessage = 'Are you sure you want to delete this space?';

            if (!confirm(confirmationMessage)) {
              event.preventDefault();
            }
          });
        });
      });
    </script>
  <% else %>
  <%# /////////////////////////////////////////////////////////////////////// %>
  </section>
  <section id="content">
<div class="hero">
  <div class="container">
    <div class="row align-items-center">
      <!-- Image column -->
      <div class="col-md-6">
        <%= image_tag "boombbba.png", alt: "Showcase Image", class: "img-1" %>
      </div>
      <!-- Text and CTA column -->
      <div class="col-md-6">
        <div class="hero-content">
          <div class="logo-2">
            <%= image_tag "spacelector.png", class: "logo-image"%>
          </div>
          <h1>Store and find your belongings fast, in one secure place</h1>
          <p>Store and find anything. Access to your space anytime, anywhere from your desktop and mobile devices. Find anything in seconds.</p>
            <%= form_for "Login", url: omniauth_authorize_path(:user, :google_oauth2), method: :post, data: { turbo: "false" }, html: { class: "button_to" } do |f| %>
              <%= button_tag(type: 'submit', class: 'btn go-to') do %>
                Get Started
              <% end %>
            <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Info Section - Text Left, Image Right -->
<div class="info-section bg-light">
  <div class="container">
    <div class="row align-items-center">
      <!-- Text column -->
      <div class="col-md-6">
        <h2>Visualize Your Space: Create and Customize Compartments</h2>
        <p>Simplify how you organize with our compartmental visualization feature. Upload images of your storage areas and easily draw compartments directly on the photos. Each compartment can be labeled and customized to represent distinct sections of your space, such as drawers or shelves.</p>
      </div>
      <!-- Image column -->
      <div class="col-md-6">
        <%= image_tag "secondfeature.png", alt: "Showcase Image", class: "img-fluid" %>
      </div>
    </div>
  </div>
</div>

<!-- Info Section - Image Left, Text Right -->
<div class="info-section">
  <div class="container">
    <div class="row align-items-center">
      <!-- Image column -->
      <div class="col-md-6">
        <%= image_tag "firstfeature2.png", alt: "Showcase Image", class: "img-fluid" %>
      </div>
      <!-- Text column -->
      <div class="col-md-6">
        <h2>Enhanced Search: Find Items by Text and Image</h2>
        <p>Experience a new level of searching where visuals meet text. With our advanced search options, you're not limited to just typing keywords. Our platform allows you to navigate visually through spaces and compartments and utilize a traditional text search to pinpoint your items. Whether it’s a quick glance at an image or a specific keyword entry, finding what you need becomes seamless and intuitive.</p>
      </div>
    </div>
  </div>
</div>

<!-- Feature Columns -->
<div class="feature-columns">
  <div class="container">
    <div class="row">
      <div class="col-md-4">
        <h2>Capture Your Space</h2>
        <p>Start by taking photos of your physical storage areas. These images form the base of your digital inventory, making your physical space accessible from anywhere, at any time.</p>
      </div>
      <div class="col-md-4">
        <h2>Interactive Compartments</h2>
        <p>Draw and label compartments on your uploaded images. This not only helps in organizing but also makes it possible to manage and update the contents of each section as your storage changes.</p>
      </div>
      <div class="col-md-4">
        <h2>Advanced Search Capabilities</h2>
        <p>Forget the hassle of traditional searching. Our app’s visual search guides you directly to the item’s location, while text-based searches quickly comb through item descriptions and compartment labels. This dual-search functionality means no more rummaging through your physical space.</p>
      </div>
    </div>
  </div>
</div>

<!-- Hero Section -->
<div class="hero-section">
  <div class="container">
    <div class="row">
      <div class="col-12">
        <h1>Manage Your Space With Ease</h1>
        <p>Our app transforms your physical storage into an easily navigable digital space.</p>
        <%= form_for "Login", url: omniauth_authorize_path(:user, :google_oauth2), method: :post, data: { turbo: "false" }, html: { class: "button_to" } do |f| %>
          <%= button_tag(type: 'submit', class: 'btn go-to') do %>
            Get Started
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
  <% end %>
</section>
