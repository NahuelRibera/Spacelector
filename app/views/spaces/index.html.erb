<div class="set">
  <div class="header">
    <h1>Spaces</h1>
    <%= link_to '+ New', new_space_path, class: 'new' %>

  </div>

  <ul class="space-list">
    <% @spaces.each do |space| %>
      <li>
        <div class="space-box">
          <%= link_to space_path(space) do %>
            <%= space.name %>
          <% end %>

          <%= form_with url: space_path(space), method: :delete, class: "delete-form" do |form| %>
            <%= form.submit 'X', data: { confirm: 'Are you sure you want to delete this space?' }, class: 'delete' %>
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      const deleteButtons = document.querySelectorAll(".delete");

      deleteButtons.forEach(button => {
        button.addEventListener("click", function(event) {
          const confirmationMessage = button.getAttribute("data-confirm");

          if (confirmationMessage && !confirm(confirmationMessage)) {
            event.preventDefault();
          }
        });
      });
    });
  </script>
</div>
