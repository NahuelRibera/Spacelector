<div class="set">
  <div class="header">
    <h1>Spaces</h1>
    <%= link_to '+ New', new_space_path, class: 'new' %>
  </div>

  <ul class="space-list">
    <% @spaces.each do |space| %>
      <li>
        <%= link_to space_path(space) do %>
          <div class="space-box">
            <%= space.name %>
            <!-- Add other content inside the space box as needed -->
          </div>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
