<div class="set">
  <div class="header">
    <h1><%= @space.name %></h1>
    <p><%= @space.description %></p>
    <%= link_to '+ New', new_space_path(parent_space_id: @space.id), class: "new" %>
  </div>

  <% if @space.parent_space %>
    <%= link_to "Back to '#{j @space.parent_space.name}'", space_path(@space.parent_space), class: "back_to" %>
  <% else %>
    <%= link_to 'Back', spaces_path, class: "back" %>
  <% end %>

  <%= link_to 'Upload image', new_space_image_path(@space), class: "upload" %>

  <ul class="space-list">
    <% @child_spaces.each do |child_space| %>
      <li>
        <div class="space-info">
          <%= link_to child_space.name, space_path(child_space) %>
          <%= form_with url: space_path(child_space), method: :delete do |form| %>
            <%= form.submit 'X', data: { confirm: 'Are you sure you want to delete this space?' }, class: "delete" %>
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>

  <!-- Display Images -->
  <div class="image-grid">
    <% @space.images.each_with_index do |image, index| %>
      <% if image.file.attached? %>
        <div class="image-container">
          <%= form_with url: space_image_path(@space, image), method: :delete, class: "delete-image-form" do |form| %>
            <%= form.submit 'X', data: { confirm: 'Are you sure you want to delete this image?' }, class: "delete" %>
          <% end %>
          <a class="demo" href="<%= url_for(image.file) %>" data-lightbox="example-<%= index + 1 %>">
            <%= image_tag(image.file, class: "grid-image example-image", alt: "image-#{index + 1}") %>
          </a>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const deleteButtons = document.querySelectorAll(".delete");

    deleteButtons.forEach(button => {
      button.addEventListener("click", function(event) {
        const confirmationMessage = button.getAttribute("data-confirm");

        if (confirmationMessage && !confirm(confirmationMessage)) {
          event.preventDefault();
        }
      });
    });
  });
</script>
