<section id="content" class="set">
  <div class="header">
    <div class="space-name">
      <h1><%= @space.name %></h1>
<a href="#" id="rename-button">
      <i id="rename-icon" class="fas fa-pen-to-square"></i>
    </a>    </div>
      <%= link_to '+ New', new_space_path(parent_space_id: @space.id), class: "new" %>
  </div>

  <% if @space.parent_space %>
    <%= link_to raw('<i class="fa-solid fa-arrow-left"></i> Back to \''.html_safe + j(@space.parent_space.name) + '\''), space_path(@space.parent_space), class: "back_to" %>
  <% else %>
    <%= link_to raw('<i class="fa-solid fa-arrow-left"></i> Back'), spaces_path, class: "back" %>
  <% end %>

  <%= link_to raw('<i class="fa-solid fa-arrow-up-from-bracket"></i> Upload image'), new_space_image_path(@space), class: "upload" %>

  <ul class="space-list">
    <% @child_spaces.each do |child_space| %>
      <li>
        <div class="space-info">
          <%= link_to child_space.name, space_path(child_space) %>
          <%= form_with url: space_path(child_space), method: :delete do |form| %>
            <%= form.submit 'X', onclick: "return confirm('Are you sure you want to delete this space?')", class: "delete-space" %>
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>

  <div class="image-grid">
    <% @space.images.each_with_index do |image, index| %>
      <% if image.file.attached? %>
        <div class="image-container">
          <div class="image-card">
            <%= image_tag(image.file, class: "grid-image example-image", alt: "image-#{index + 1}",
                          data: { image_id: image.id, compartments: compartments_for_image(image).to_json }) %>
            <div class="title">
              <h5><%= image.title %></h5>
            </div>
            <%= form_with url: space_image_path(@space, image), method: :delete,
                          data: { confirm: 'Are you sure you want to delete this image?' }, class: "delete-image-form" do |form| %>
              <%= form.submit 'X', class: "delete" %>
            <% end %>
          </div>
        </div>
        <% image.compartments.each do |compartment| %>
          <!-- Trigger element for showing compartment info -->
          <div data-compartment-id="<%= compartment.id %>" class="compartment-info-trigger">
            <%= compartment.name %>
          </div>

          <!-- The compartment info to be displayed -->
          <div id="compartment-info-<%= compartment.id %>" class="compartment-info" style="display: none;">
            <textarea id="description-<%= compartment.id %>" placeholder="Enter object description"></textarea><br>
            <button onclick="saveObjectInfo(<%= compartment.id %>)">Save</button>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <!-- Modal to display the image and compartments -->
  <div id="image-modal" class="modal-overlay">
    <div class="modal-content">
      <span class="close-modal"></span>
      <div class="modal-body">
        <canvas id="modal-canvas" class="modal-canvas"></canvas>
        <div id="compartment-info-boxes" class="compartment-info-container"></div>
      </div>
    </div>
  </div>

<script>
  // Debounce function to prevent excessive save operations
  function debounce(func, wait) {
    let timeout;
    return function(...args) {
      const later = () => {
        clearTimeout(timeout);
        func.apply(this, args);
      };
      clearTimeout(timeout);
      timeout = setTimeout(later, wait);
    };
  }

  // Function to save compartment info with debounce
  function saveCompartmentInfoDebounced(compartmentId) {
    const description = document.getElementById('description-' + compartmentId).value;
    fetch(`/compartments/${compartmentId}/object_infos`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
      },
      body: JSON.stringify({ object_info: { description: description } })
    })
    .then(response => {
      if (!response.ok) {
        throw new Error(`Network response was not ok: ${response.statusText}`);
      }
      return response.json();
    })
    .then(data => {
      console.log('Saved successfully', data);
      // Update the DOM here
      const textarea = document.getElementById('description-' + data.compartment_id);
      if (textarea) {
          textarea.value = data.description; // Ensure the textarea displays the latest saved description
      }
   })
    .catch((error) => {
      console.error('Error saving:', error);
    });
  }

  document.addEventListener('DOMContentLoaded', function() {
    const images = document.querySelectorAll('.grid-image');
    const modal = document.getElementById('image-modal');
    const modalCanvas = document.getElementById('modal-canvas');
    const closeModal = document.querySelector('.close-modal');
    const infoContainer = document.getElementById('compartment-info-boxes');
    const spaceName = document.getElementById('space-name');
    const renameButton = document.getElementById('rename-button');
    let clickedImage = null;

    // Function to update the space name via AJAX
    function updateSpaceName(newName) {
      fetch('<%= update_space_name_path(@space) %>', {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': '<%= form_authenticity_token %>'
        },
        body: JSON.stringify({ name: newName })
      })
      .then(response => {
        if (response.ok) {
          // Update the space name in the DOM
          spaceName.textContent = newName;
        }
      })
      .catch(error => {
        console.error(error);
      });
    }

    // Event listener for renaming the space name
    renameButton.addEventListener('click', function() {
      const newName = prompt('Enter the new name for the space:');
      if (newName !== null && newName.trim() !== '') {
        updateSpaceName(newName);
        // Refresh the page after 1 second
        setTimeout(function() {
          window.location.reload();
        }, 100);
      }
    });

    images.forEach(image => {
        image.addEventListener('click', function() {
            const imageId = this.getAttribute('data-image-id');
            if (!imageId) {
                console.error('Image ID is undefined. Check data-image-id attribute of the image element.');
                return;
            }

            fetch(`/images/${imageId}/compartments`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`Network response was not ok: ${response.statusText}`);
                    }
                    return response.json();
                })
                .then(compartmentsData => {
                    modal.style.display = 'block';
                    const context = modalCanvas.getContext('2d');
                    const img = new Image();

                    img.onload = function() {
                        modalCanvas.width = img.width;
                        modalCanvas.height = img.height;
                        context.drawImage(img, 0, 0);
                        infoContainer.innerHTML = ''; // Clear existing boxes before appending new ones
                        compartmentsData.forEach((compartment, index) => {
    compartment.number = index + 1; // Assigning number to each compartment
    drawCompartment(context, compartment);
    const compartmentInfoBox = createCompartmentInfoBox(compartment);
    infoContainer.appendChild(compartmentInfoBox);
});

                    };
                    img.src = this.src;
                })
                .catch(error => console.error('Error fetching compartment data:', error));
        });
    });

    closeModal.addEventListener('click', function() {
        modal.style.display = 'none';
        infoContainer.innerHTML = '';
    });

    // Updated to close modal when clicking outside the image
    window.addEventListener('click', function(event) {
      if (event.target === modal) {
        modal.style.display = 'none';
        infoContainer.innerHTML = ''; // Clear compartment info boxes
      }
    });

    function drawCompartment(context, compartment) {
  context.beginPath();
  context.rect(compartment.x, compartment.y, compartment.width, compartment.height);
  context.strokeStyle = '#44A0D8';
  context.lineWidth = 5;
  context.stroke();
  context.fillStyle = 'red';
  context.fillText(compartment.number.toString(), compartment.x, compartment.y - 5); // Display number instead of name
}

    function createCompartmentInfoBox(compartment) {
  console.log('Creating box for Compartment ID:', compartment.id);

  const box = document.createElement('div');
  box.classList.add('compartment-info');
  box.id = `compartment-info-${compartment.id}`;

  const label = document.createElement('label');
  label.textContent = compartment.number.toString(); // Display number instead of name

  const textarea = document.createElement('textarea');
  textarea.id = 'description-' + compartment.id;
  textarea.dataset.compartmentId = compartment.id;
  textarea.value = compartment.description || ""; // Set initial value if available
  textarea.addEventListener('input', debounce((event) => {
    const debouncedCompartmentId = event.target.dataset.compartmentId;
    saveCompartmentInfoDebounced(debouncedCompartmentId);
  }, 500));

  box.appendChild(label);
  box.appendChild(textarea);

  return box;
}
  });
</script>
