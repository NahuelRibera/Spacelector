<div class="set">
  <div class="header">
    <h1><%= @space.name %></h1>
    <p><%= @space.description %></p>
    <%= link_to '+ New', new_space_path(parent_space_id: @space.id), class: "new" %>
  </div>

  <% if @space.parent_space %>
    <%= link_to "Back to '#{j @space.parent_space.name}'", space_path(@space.parent_space), class: "back_to" %>
  <% else %>
    <%= link_to 'Back', spaces_path, class: "back" %>
  <% end %>

  <%= link_to 'Upload image', new_space_image_path(@space), class: "upload" %>

  <!-- Display Images -->
  <div class="image-grid">
    <% @space.images.each do |image| %>
      <% if image.file.attached? %>
        <%= image_tag image.file, class: "grid-image" %>

        <!-- Display Boxes -->
        <div class="boxes-container" data-image-id="<%= image.id %>">
          <%= render partial: 'boxes/form', locals: { image: image, box: Box.new } %>

          <% if image.boxes.present? %>
            <% image.boxes.each do |box| %>
              <p>
                Top: <%= box.top %>, Left: <%= box.left %>, Width: <%= box.width %>, Height: <%= box.height %>
                <%= link_to 'Edit', edit_image_box_path(image, box) %>
                <%= link_to 'Destroy', image_box_path(image, box), method: :delete, data: { confirm: 'Are you sure?' } %>
              </p>
            <% end %>
          <% else %>
            <p>No boxes to render.</p>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      const deleteButtons = document.querySelectorAll(".delete");

      deleteButtons.forEach(button => {
        button.addEventListener("click", function(event) {
          const confirmationMessage = button.getAttribute("data-confirm");

          if (confirmationMessage && !confirm(confirmationMessage)) {
            event.preventDefault();
          }
        });
      });

      const newBoxForms = document.querySelectorAll('.new-box-form');

      newBoxForms.forEach(form => {
        form.addEventListener('ajax:success', function(event) {
          const [data, status, xhr] = event.detail;
          const boxesContainer = form.closest('.boxes-container');
          boxesContainer.insertAdjacentHTML('beforeend', data);

          // Clear the form
          form.reset();
        });
      });
    });
  </script>
</div>
