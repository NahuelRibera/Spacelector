<section id="content" class="set">
  <div class="header-space">
    <div class="space-name">
      <h1><%= @space.name %></h1>
        <a href="#" id="rename-button">
      <i id="rename-icon" class="fas fa-pen-to-square"></i>
    </a>    </div>
    <div class="rotated-hud">
      <% if @space.parent_space %>
        <%= link_to raw('<i class="fa-solid fa-arrow-left"></i> Back to \''.html_safe + j(@space.parent_space.name) + '\''), space_path(@space.parent_space), class: "back_to" %>
      <% else %>
       <%= link_to raw('<i class="fa-solid fa-arrow-left"></i> Back'), spaces_path, class: "back" %>
      <% end %>

      <%= link_to raw('<i class="fa-solid fa-arrow-up-from-bracket"></i> Upload image'), new_space_image_path(@space), class: "upload" %>


      <%= link_to '+ New', new_space_path(parent_space_id: @space.id), class: "new" %>
    </div>
    <div class="default-hud">
      <%= link_to '+ New', new_space_path(parent_space_id: @space.id), class: "new" %>
    </div>
  </div>

  <div class="default-hud">
    <% if @space.parent_space %>
      <%= link_to raw('<i class="fa-solid fa-arrow-left"></i> Back to \''.html_safe + j(@space.parent_space.name) + '\''), space_path(@space.parent_space), class: "back_to" %>
    <% else %>
      <%= link_to raw('<i class="fa-solid fa-arrow-left"></i> Back'), spaces_path, class: "back" %>
    <% end %>

    <%= link_to raw('<i class="fa-solid fa-arrow-up-from-bracket"></i> Upload image'), new_space_image_path(@space), class: "upload" %>
  </div>

  <ul class="space-list">
    <% @child_spaces.each do |child_space| %>
      <li>
        <div class="space-info">
          <%= link_to child_space.name, space_path(child_space) %>
          <%= form_with url: space_path(child_space), method: :delete do |form| %>
            <%= form.submit 'X', onclick: "return confirm('Are you sure you want to delete this space?')", class: "delete-space" %>
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>

  <div class="image-grid">
    <% @space.images.each_with_index do |image, index| %>
      <% if image.file.attached? %>
        <div class="image-container">
          <div class="image-card">
            <%# Check if the image is a HEIC file and conditionally apply resizing %>
            <% if image.file.content_type == 'image/heic' %>
              <%= image_tag(image.file.variant(resize_to_limit: [1920, 1080]), class: "grid-image example-image", alt: "image-#{index + 1}",
                            data: { image_id: image.id, compartments: compartments_for_image(image).to_json }) %>
            <% else %>
              <%= image_tag(image.file, class: "grid-image example-image", alt: "image-#{index + 1}",
                            data: { image_id: image.id, compartments: compartments_for_image(image).to_json }) %>
            <% end %>
            <div class="title">
              <h5><%= image.title %></h5>
            </div>
             <%= form_with url: space_image_path(@space, image), method: :delete, class: "delete-image-form", data: { confirm: 'Are you sure you want to delete this image?' } do |form| %>
            <%= form.submit 'X', class: "delete" %>
          <% end %>
          </div>
        </div>
        <!-- Rest of your code -->
      <% end %>
    <% end %>
  </div>

  <div id="image-modal" class="modal-overlay">
    <div class="modal-content">
      <span class="close-modal"></span>
      <div class="modal-body">
        <canvas id="modal-canvas" class="modal-canvas"></canvas>
        <div id="compartment-info-boxes" class="compartment-info-container">
        </div>
      </div>
    </div>
  </div>

<script>
  function handlePageLoad() {
    const textareas = document.querySelectorAll('textarea');
    textareas.forEach(textarea => {
      textarea.style.height = 'auto'; // Reset height to auto to properly calculate new height
      textarea.style.height = textarea.scrollHeight + 'px'; // Set the height to the scrollHeight, ensuring all content is visible
    });
  }

  document.addEventListener('DOMContentLoaded', function() {
  var deleteForms = document.querySelectorAll('.delete-image-form');

  deleteForms.forEach(function(form) {
    form.addEventListener('submit', function(event) {
      var confirmMessage = form.getAttribute('data-confirm');
      if (!confirm(confirmMessage)) {
        event.preventDefault();
      }
    });
  });
});

  document.addEventListener('DOMContentLoaded', handlePageLoad);
  // Define the debounce function
  function debounce(func, wait) {
    let timeout;
    return function(...args) {
      const later = () => {
        clearTimeout(timeout);
        func.apply(this, args);
      };
      clearTimeout(timeout);
      timeout = setTimeout(later, wait);
    };
  }

  function debounce(func, wait) {
    let timeout;
    return function(...args) {
      const later = () => {
        clearTimeout(timeout);
        func.apply(this, args);
      };
      clearTimeout(timeout);
      timeout = setTimeout(later, wait);
    };
  }

window.addEventListener('load', function() {
  const queryParams = new URLSearchParams(window.location.search);
  const imageId = queryParams.get('image_id');
  const compartmentId = queryParams.get('highlight_compartment_id');

  if (imageId && compartmentId) {
    showModalForImage(imageId);
    // Wait for the modal to potentially finish loading before highlighting compartments
    setTimeout(() => {
      highlightCompartment(compartmentId);
    }, 500); // You may need to adjust this delay based on how long your modal takes to load
  }
});

function showModalForImage(imageId) {
  // Find the image element that should be clicked to show the modal.
  const imageElement = document.querySelector(`[data-image-id="${imageId}"]`);
  if (imageElement) {
    // Trigger the click event programmatically
    imageElement.click();
  } else {
    console.error('Image element not found for imageId:', imageId);
  }
}

function highlightCompartment(compartmentId) {
  // This function gets called after the delay set in showModalForImage to ensure
  // that the modal has had time to load and display
  waitForCompartmentInfoToBeReady(compartmentId, () => {
    const compartmentTextArea = document.querySelector(`#description-${compartmentId}`);
    if (compartmentTextArea) {
      compartmentTextArea.style.border = '2px solid #44A0D8';
      compartmentTextArea.scrollIntoView({ behavior: 'smooth', block: 'center' });
      compartmentTextArea.focus(); // Optionally set focus to the textarea
    } else {
      console.error('Textarea element not found for compartmentId:', compartmentId);
    }
  });
}

function waitForCompartmentInfoToBeReady(compartmentId, callback) {
  const checkInterval = 100;
  const maxAttempts = 50;
  let attempts = 0;

  const checkForCompartmentInfo = () => {
    attempts++;
    const compartmentElement = document.getElementById(`compartment-info-${compartmentId}`);
    if (compartmentElement) {
      callback(); // Compartment info is ready, call the callback.
    } else if (attempts < maxAttempts) {
      setTimeout(checkForCompartmentInfo, checkInterval); // Try again after a short delay.
    } else {
      console.error('Compartment info box not found for compartmentId:', compartmentId);
    }
  };

  checkForCompartmentInfo();
}


  document.addEventListener('DOMContentLoaded', handlePageLoad);
  // Define the debounce function
  function debounce(func, wait) {
    let timeout;
    return function(...args) {
      const later = () => {
        clearTimeout(timeout);
        func.apply(this, args);
      };
      clearTimeout(timeout);
      timeout = setTimeout(later, wait);
    };
  }

  function autoResizeTextarea(event) {
    const textarea = event.target;
    textarea.style.height = 'auto';
    textarea.style.height = textarea.scrollHeight + 'px';
  }

function createCompartmentInfoBox(compartment) {
  console.log('Creating box for Compartment ID:', compartment.id);

  const box = document.createElement('div');
  box.classList.add('compartment-info');
  box.id = `compartment-info-${compartment.id}`;

  const label = document.createElement('label');
  label.textContent = compartment.number.toString();

  const textarea = document.createElement('textarea');
  textarea.id = 'description-' + compartment.id;
  textarea.dataset.compartmentId = compartment.id;

  // Fetch the latest object_info for this compartment and update the textarea value
  fetchCompartmentObjectInfo(compartment.id).then(description => {
    textarea.value = description; // Set the fetched description
  });

  textarea.addEventListener('input', debounce((event) => {
    const compartmentId = event.target.dataset.compartmentId;
    const descriptionValue = event.target.value;
    saveCompartmentInfoDebounced(compartmentId, descriptionValue);
  }, 500));

  box.appendChild(label);
  box.appendChild(textarea);
  autoResizeTextarea({ target: textarea });

  return box;
}

function fetchCompartmentObjectInfo(compartmentId) {
  return fetch(`/compartments/${compartmentId}/object_infos/last`)
    .then(response => {
      if (!response.ok) {
        if (response.status === 404) {
          // Handle not found error gracefully
          return { description: "" }; // Return a default empty description
        }
        throw new Error(`Network response was not ok: ${response.statusText}`);
      }
      return response.json();
    })
    .then(data => {
      // Ensure data.description exists or return an empty string
      return data.description || "";
    })
    .catch(error => console.error('Error fetching compartment object info:', error));
}

function saveCompartmentInfoDebounced(compartmentId, description) {
  console.log(`Saving description for compartment ${compartmentId}: '${description}'`);

  fetch(`/compartments/${compartmentId}/object_infos/create_or_update`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
    },
    body: JSON.stringify({ object_info: { description: description } })
  })
  .then(response => {
    if (!response.ok) {
      throw new Error(`Network response was not ok: ${response.statusText}`);
    }
    return response.json();
  })
  .then(data => {
    console.log('Server Response:', data);
    const textarea = document.getElementById('description-' + compartmentId);
    if (textarea) {
      textarea.value = data.description; // Ensure the textarea is updated with the saved description
    }
  })
  .catch(error => {
    console.error('Error saving:', error);
  });
}


  document.addEventListener('DOMContentLoaded', function() {
    // Assuming you're using Devise or similar for authentication
    const userId = '<%= current_user.id %>';

    // Function to fetch compartment info box data associated with the user
    function fetchCompartmentInfo(imageId) {
      fetch(`/images/${imageId}/compartments`)
        .then(response => {
          if (!response.ok) {
            throw new Error(`Network response was not ok: ${response.statusText}`);
          }
          return response.json();
        })
        .then(compartmentsData => {
          // Populate the modal with compartment information
          populateCompartmentInfo(compartmentsData);
        })
        .catch(error => console.error('Error fetching compartment data:', error));
    }

    // Fetch compartment info box data when the page loads
    fetchCompartmentInfo(userId);

    const images = document.querySelectorAll('.grid-image');
    const modal = document.getElementById('image-modal');
    const modalCanvas = document.getElementById('modal-canvas');
    const closeModal = document.querySelector('.close-modal');
    const spaceName = document.getElementById('space-name');
    const renameButton = document.getElementById('rename-button');
    let clickedImage = null;

    const compartmentsInfoBoxes = {};

    function updateSpaceName(newName) {
      fetch('<%= update_space_name_path(@space) %>', {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': '<%= form_authenticity_token %>'
        },
        body: JSON.stringify({ name: newName })
      })
      .then(response => {
        if (response.ok) {
          spaceName.textContent = newName;
        }
      })
      .catch(error => {
        console.error(error);
      });
    }

    renameButton.addEventListener('click', function() {
      const newName = prompt('Enter the new name for the space:');
      if (newName !== null && newName.trim() !== '') {
        updateSpaceName(newName);
        setTimeout(function() {
          window.location.reload();
        }, 100);
      }
    });

    images.forEach(image => {
      image.addEventListener('click', function() {
        const imageId = this.getAttribute('data-image-id');
        if (!imageId) {
          console.error('Image ID is undefined. Check data-image-id attribute of the image element.');
          return;
        }

        const infoContainer = document.getElementById('compartment-info-boxes');
        infoContainer.innerHTML = ''; // Clear existing info boxes

        if (compartmentsInfoBoxes[imageId]) {
          // If compartments info boxes already exist for this image, use them
          compartmentsInfoBoxes[imageId].forEach(box => {
            infoContainer.appendChild(box);
          });
          modal.style.display = 'block'; // Show the modal
        } else {
          // Otherwise, fetch compartment data from the server
          fetch(`/images/${imageId}/compartments`)
            .then(response => {
              if (!response.ok) {
                throw new Error(`Network response was not ok: ${response.statusText}`);
              }
              return response.json();
            })
            .then(compartmentsData => {
              modal.style.display = 'block'; // Show the modal
              const context = modalCanvas.getContext('2d');
              const img = new Image();

              img.onload = function() {
                modalCanvas.width = img.width;
                modalCanvas.height = img.height;
                context.drawImage(img, 0, 0);

                const infoBoxes = [];
                compartmentsData.forEach((compartment, index) => {
                  compartment.number = index + 1;
                  drawCompartment(context, compartment);

                  // Create info box for each compartment
                  const compartmentInfoBox = createCompartmentInfoBox(compartment);
                  infoContainer.appendChild(compartmentInfoBox);
                  infoBoxes.push(compartmentInfoBox);
                });

                // Store the info boxes for future use
                compartmentsInfoBoxes[imageId] = infoBoxes;
              };
              img.src = this.src;
            })
            .catch(error => console.error('Error fetching compartment data:', error));
        }
      });
    });

    closeModal.addEventListener('click', function() {
      modal.style.display = 'none';
      infoContainer.innerHTML = '';
    });

    window.addEventListener('click', function(event) {
      if (event.target === modal) {
        modal.style.display = 'none';
        const infoContainer = document.getElementById('compartment-info-boxes'); // Moved inside window click event listener
        infoContainer.innerHTML = '';
      }
    });

    function drawCompartment(context, compartment) {
      context.beginPath();
      context.rect(compartment.x, compartment.y, compartment.width, compartment.height);
      context.strokeStyle = '#44A0D8';
      context.lineWidth = 4.5;
      context.stroke();
      context.fillStyle = 'black';
      context.font = 'bold 50px Open Sans';
      context.lineWidth = 6;
      context.strokeStyle = '#44A0D8'; // Change the color of the outline as desired
      context.strokeText(compartment.number.toString(), compartment.x + 15, compartment.y + 52);
      context.fillText(compartment.number.toString(), compartment.x + 15, compartment.y + 52);
    }
  });
</script>
