<section id="content" class="set">
  <div class="header">
    <h1><%= @space.name %></h1>
    <%= link_to '+ New', new_space_path(parent_space_id: @space.id), class: "new" %>
  </div>

  <% if @space.parent_space %>
    <%= link_to raw('<i class="fa-solid fa-arrow-left"></i> Back to \''.html_safe + j(@space.parent_space.name) + '\''), space_path(@space.parent_space), class: "back_to" %>
  <% else %>
    <%= link_to raw('<i class="fa-solid fa-arrow-left"></i> Back'), spaces_path, class: "back" %>
  <% end %>

  <%= link_to raw('<i class="fa-solid fa-arrow-up-from-bracket"></i> Upload image'), new_space_image_path(@space), class: "upload" %>

  <ul class="space-list">
    <% @child_spaces.each do |child_space| %>
      <li>
        <div class="space-info">
          <%= link_to child_space.name, space_path(child_space) %>
          <%= form_with url: space_path(child_space), method: :delete do |form| %>
            <%= form.submit 'X', onclick: "return confirm('Are you sure you want to delete this space?')", class: "delete-space" %>
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>

  <div class="image-grid">
    <% @space.images.each_with_index do |image, index| %>
      <% if image.file.attached? %>
        <div class="image-container">
          <div class="image-card">
            <%= image_tag(image.file, class: "grid-image example-image", alt: "image-#{index + 1}", data: { compartments: compartments_for_image(image) }) %>
            <div class="title">
              <h5><%= image.title %></h5>
            </div>
            <%= form_with url: space_image_path(@space, image), method: :delete, data: { confirm: 'Are you sure you want to delete this image?' }, class: "delete-image-form" do |form| %>
              <%= form.submit 'X', class: "delete" %>
            <% end %>
          </div>
        </div>
        <% image.compartments.each do |compartment| %>
          <!-- Trigger element for showing compartment info -->
          <div data-compartment-id="<%= compartment.id %>" class="compartment-info-trigger">
            <%= compartment.name %>
          </div>

          <!-- The compartment info to be displayed -->
          <!-- The compartment info to be displayed -->
          <div id="compartment-info-<%= compartment.id %>" class="compartment-info" style="display: none;">
            Description: <textarea id="description-<%= compartment.id %>" placeholder="Enter object description"></textarea><br>
            <button onclick="saveObjectInfo(<%= compartment.id %>)">Save</button>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <!-- Modal to display the image and compartments -->
  <div id="image-modal" class="modal-overlay">
    <div class="modal-content">
      <span class="close-modal">&times;</span>
      <div class="modal-body">
        <img id="modal-image" class="modal-image" src="" alt="Modal Image">
        <canvas id="modal-canvas" class="modal-canvas"></canvas>
        <div id="compartment-info-boxes" class="compartment-info-container"></div>
      </div>
    </div>
  </div>

<script>
  // Debounce function to prevent excessive save operations
  function debounce(func, wait) {
    let timeout;
    return function(...args) {
      const later = () => {
        clearTimeout(timeout);
        func.apply(this, args);
      };
      clearTimeout(timeout);
      timeout = setTimeout(later, wait);
    };
  }

  // Function to save compartment info with debounce
  function saveCompartmentInfoDebounced(compartmentId) {
    var description = document.getElementById('description-' + compartmentId).value;
    // Replace with your actual save logic
    fetch('/compartments/' + compartmentId + '/object_infos', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
      },
      body: JSON.stringify({ description: description })
    })
    .then(response => response.json())
    .then(data => {
      console.log('Saved successfully', data);
    })
    .catch((error) => {
      console.error('Error saving:', error);
    });
  }

  document.addEventListener('DOMContentLoaded', function() {
    const images = document.querySelectorAll('.grid-image');
    const modal = document.getElementById('image-modal');
    const modalBody = document.querySelector('.modal-body');
    const modalCanvas = document.getElementById('modal-canvas');
    const closeModal = document.querySelector('.close-modal');
    const infoContainer = document.getElementById('compartment-info-boxes');
    let clickedImage = null;

    images.forEach(image => {
      image.addEventListener('click', function() {
        clickedImage = this;
        const compartmentsData = JSON.parse(image.dataset.compartments);
        modal.style.display = 'block';
        const context = modalCanvas.getContext('2d');
        const img = new Image();

        img.onload = function() {
          modalCanvas.width = img.width;
          modalCanvas.height = img.height;
          context.drawImage(img, 0, 0);
          compartmentsData.forEach(compartment => {
            drawCompartment(context, compartment);
          });
        };
        img.src = clickedImage.src;

        infoContainer.innerHTML = ''; // Clear existing compartment info boxes

        compartmentsData.forEach(compartment => {
          const compartmentInfoBox = createCompartmentInfoBox(compartment);
          infoContainer.appendChild(compartmentInfoBox);
        });
      });
    });

    closeModal.addEventListener('click', function() {
      modal.style.display = 'none';
      clickedImage = null;
      infoContainer.innerHTML = ''; // Clear compartment info boxes
    });

    modal.addEventListener('click', function(event) {
      if (event.target.classList.contains('compartment-info-trigger')) {
        const compartmentId = event.target.getAttribute('data-compartment-id');
        toggleCompartmentInfo(compartmentId);
      }
    });

    window.addEventListener('click', function(event) {
      if (event.target === modal) {
        modal.style.display = 'none';
        if (clickedImage) {
          clickedImage = null;
        }
        removeCompartmentTriggers();
      }
    });

    function drawCompartment(context, compartment) {
      context.beginPath();
      context.rect(compartment.x, compartment.y, compartment.width, compartment.height);
      context.strokeStyle = '#44A0D8';
      context.lineWidth = 5;
      context.stroke();
      context.fillStyle = 'red';
      context.fillText(compartment.name, compartment.x, compartment.y - 5);
    }

    function createCompartmentInfoBox(compartment) {
      const box = document.createElement('div');
      box.classList.add('compartment-info');
      box.id = `compartment-info-${compartment.id}`;

      const label = document.createElement('label');
      label.textContent = compartment.name + ': ';

      const textarea = document.createElement('textarea');
      textarea.id = 'description-' + compartment.id;
      // Store compartment ID in the dataset for easy access
      textarea.dataset.compartmentId = compartment.id;

      // Wrap the debounce call in a closure that captures the current compartment ID
      textarea.addEventListener('input', debounce(function() {
        // Retrieve the compartment ID from the dataset
        saveCompartmentInfoDebounced(this.dataset.compartmentId);
      }, 500)); // Autosave with debounce

      box.appendChild(label);
      box.appendChild(textarea);

      return box;
    }

    function saveCompartmentInfoDebounced(compartmentId) {
      const description = document.getElementById('description-' + compartmentId).value;
      const objectInfoData = {
        object_info: { description: description }
      };

      fetch('/compartments/' + compartmentId + '/object_infos', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
        },
        body: JSON.stringify(objectInfoData)
      })
      .then(response => {
        if (!response.ok) {
          throw new Error('Network response was not ok ' + response.statusText);
        }
        return response.json();
      })
      .then(data => {
        console.log('Success:', data);
      })
      .catch((error) => {
        console.error('Error saving:', error);
      });
    }

    function toggleCompartmentInfo(compartmentId) {
      const infoDiv = document.getElementById(`compartment-info-${compartmentId}`);
      infoDiv.style.display = infoDiv.style.display === 'none' ? 'block' : 'none';
    }

    function removeCompartmentTriggers() {
      document.querySelectorAll('.compartment-info-trigger').forEach(trigger => trigger.remove());
    }
  });
</script>
