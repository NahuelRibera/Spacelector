    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" integrity="sha512-xr2UyCgPpxDrevNcj23s/Vr5KSn/lqepCnf+TK0mbv1SjrMlMHgDZTjjnW2s2AA0E1Jy2lO3Xqai+3uPlxJ1dQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />

