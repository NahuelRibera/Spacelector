<div class="navbar navbar-expand navbar-light navbar-lewagon">
  <%= link_to root_path, class: "navbar-brand" do %>
    <%= image_tag "spacelector.png" %>
  <% end %>

  <ul class="navbar-nav me-auto">
    <% if user_signed_in? %>
      <li class="nav-item">
        <%= link_to "Premium Trial", checkout_path, class: "nav-link premium-trial" %>
      </li>
      <li class="nav-item">
        <%= link_to "Manage billing", @portal_sessions.url unless @portal_session.nil? %>
      </li>
      <li class="nav-item">
        <%= form_with(url: destroy_user_session_path, method: :delete, local: false, class: "form-inline") do %>
          <button type="submit" class="btn nav-link sign-out-button">
            <%= image_tag('exit.png', alt: 'Sign out') %>
          </button>
        <% end %>
      </li>
    <% else %>
      <li class="nav-item">
        <%= link_to "Login", new_user_session_path, class: "nav-link btn-login" %>
      </li>
      <li class="nav-item">
        <%= link_to "Sign up", new_user_registration_path, class: "nav-link btn-login" %>
      </li>
    <% end %>
  </ul>
</div>
