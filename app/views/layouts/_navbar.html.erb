<div class="navbar navbar-expand navbar-light navbar-lewagon">
  <div class="logo-items">
    <%= link_to root_path do %>
      <% if user_signed_in? %>
        <%= image_tag "spacelector_crop.png", class: "logo" %>
      <% else %>
        <%= image_tag "spacelector_crop.png", class: "logo-home" %>
      <% end %>
    <% end %>

    <% if !user_signed_in? %>
      <div class="navbar-toggle">
      <button id="toggleButton"><i class="fa-solid fa-bars"></i></button>
      <div class="dropdown-menu" id="dropdownMenu">
      <ul class="toggle-menu">
        <li class="nav-section-item"><a href="#section1" class="nav-link-section">Overview</a></li>
        <li class="nav-section-item"><a href="#section2" class="nav-link-section">Features</a></li>
        <li class="nav-section-item"><a href="#section3" class="nav-link-section">Reviews</a></li>
    </ul>
  </div>
</div>
<div class="nav-links">
  <ul class="navbar-nav">
    <li class="nav-section-item"><%= link_to t('navbar.overview'), "#section1", class: "nav-link-section" %></li>
    <li class="nav-section-item"><%= link_to t('navbar.features'), "#section2", class: "nav-link-section" %></li>
    <li class="nav-section-item"><%= link_to t('navbar.reviews'), "#section3", class: "nav-link-section" %></li>
    <li class="nav-section-item language-dropdown">
      <div class="dropdown">
        <button class="dropdown-toggle" type="button" id="languageDropdown" data-bs-toggle="dropdown" aria-expanded="false">
          <%= I18n.locale == :en ? 'ENG' : 'ES' %> <%= image_tag "#{I18n.locale == :en ? 'eng.jpg' : 'es.png'}", class: "flag-icon" %>
        </button>
        <ul class="dropdown-menu" aria-labelledby="languageDropdown">
          <% if I18n.locale != :en %>
            <li>
              <%= link_to locale: 'en' do %>
                ENG <%= image_tag "eng.jpg", alt: "English", class: "flag-icon" %>
              <% end %>
            </li>
          <% end %>
          <% if I18n.locale != :es %>
            <li>
              <%= link_to locale: 'es' do %>
                ES <%= image_tag "es.png", alt: "Spanish", class: "flag-icon" %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </li>
  </ul>
</div>
    <% end %>
  </div>

  <% if user_signed_in? %>
    <div class="navbar-search-container">
      <%= form_with url: search_spaces_path, method: :get, local: true, class: "search-form" do |form| %>
        <%= form.text_field :query, placeholder: "What are you looking for?", autocomplete: "off", class: "search-input" %>
      <% end %>
    </div>
    <!-- Somewhere in your HTML, possibly at the end of the body -->
    <div id="search-results-dropdown" class="search-results-dropdown"></div>
        <%= form_with(url: destroy_user_session_path, method: :delete, local: false, class: "form-inline") do %>
          <button type="submit" onclick="return confirm('Are you sure you want to sign out?')" class="btn sign-out-button">
            <%= image_tag('exit.png', alt: 'Sign out') %>
          </button>
        <% end %>
  <% else %>
    <div class="right-buttons">
      <%= form_for "Login", url: omniauth_authorize_path(:user, :google_oauth2), method: :post, data: { turbo: "false" }, html: { class: "button_to" } do |f| %>
        <%= button_tag(type: 'submit', class: 'btn google-btn sign') do %>
          <%= t('navbar.signin') %>
        <% end %>
      <% end %>

      <%= form_for "Login", url: omniauth_authorize_path(:user, :google_oauth2), method: :post, data: { turbo: "false" }, html: { class: "button_to" } do |f| %>
        <%= button_tag(type: 'submit', class: 'btn google-btn go-to') do %>
          <%= t('navbar.goto') %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>


<script>
  document.addEventListener("DOMContentLoaded", function() {
  var toggleButton = document.getElementById("toggleButton");
  var dropdownMenu = document.getElementById("dropdownMenu");

  toggleButton.addEventListener("click", function() {
    if (dropdownMenu.style.display === "none" || dropdownMenu.style.display === "") {
      dropdownMenu.style.display = "block";
    } else {
      dropdownMenu.style.display = "none";
    }
  });
});





  document.addEventListener("DOMContentLoaded", function() {
    const navLinks = document.querySelectorAll('.nav-link-section');
    const sections = document.querySelectorAll('section'); // Ensure the selector matches your sections

    // Set the 'active' class based on the scroll position
    function setActiveLinkOnScroll() {
      let currentSectionIndex = -1;
      sections.forEach((section, index) => {
        const sectionTop = section.getBoundingClientRect().top + window.pageYOffset;
        const sectionBottom = sectionTop + section.offsetHeight;
        if (window.pageYOffset >= sectionTop && window.pageYOffset < sectionBottom) {
          currentSectionIndex = index;
        }
      });

      if (currentSectionIndex !== -1) {
        navLinks.forEach((link, index) => {
          link.classList.toggle('active', index === currentSectionIndex);
        });
      }
    }

    // Listen to scroll events
    window.addEventListener('scroll', setActiveLinkOnScroll);

    // Smooth scroll to the section when a nav link is clicked
    navLinks.forEach((link, index) => {
      link.addEventListener('click', function(event) {
        event.preventDefault(); // Prevent default anchor behavior
        const targetId = link.getAttribute('href').substring(1);
        const targetSection = document.getElementById(targetId);

        // Perform smooth scrolling to the target section
        targetSection.scrollIntoView({ behavior: 'smooth' });

        // Set 'active' class after scrolling ends
        navLinks.forEach(lnk => lnk.classList.remove('active'));
        link.classList.add('active');

        // Update the URL hash without page jump
        history.pushState(null, null, '#' + targetId);
      });
    });

    // Update active link on load and when resizing or changing the orientation of the device
    setActiveLinkOnScroll();
    window.addEventListener('resize', setActiveLinkOnScroll);
    window.addEventListener('orientationchange', setActiveLinkOnScroll);
  });
</script>
