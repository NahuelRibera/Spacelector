<div class="navbar navbar-expand navbar-light navbar-lewagon">
  <div class="logo-items">
  <%= link_to root_path do %>
    <%= image_tag "spacelector.png", class: "logo" %>
    <% if !user_signed_in? %>
      <ul class="navbar-nav">
          <li class="nav-section-item"><%= link_to "Overview", "#section1", class: "nav-link-section" %></li>
          <li class="nav-section-item"><%= link_to "Features", "#section2", class: "nav-link-section" %></li>
          <li class="nav-section-item"><%= link_to "Pricing", "#section3", class: "nav-link-section" %></li>
          <li class="nav-section-item"><%= link_to "Download", "#section4", class: "nav-link-section" %></li>
      </ul>
    <% end %>
  <% end %>
  </div>

  <% if user_signed_in? %>
    <div class="navbar-search-container">
      <%= form_with url: search_spaces_path, method: :get, local: true, class: "search-form" do |form| %>
        <%= form.text_field :query, placeholder: "What are you looking for?", autocomplete: "off", class: "search-input" %>
      <% end %>
    </div>
    <!-- Somewhere in your HTML, possibly at the end of the body -->
    <div id="search-results-dropdown" class="search-results-dropdown"></div>

    <ul class="navbar-nav">
      <li class="nav-item">
        <%= form_with(url: destroy_user_session_path, method: :delete, local: false, class: "form-inline") do %>
          <button type="submit" onclick="return confirm('Are you sure you want to sign out?')" class="btn nav-link sign-out-button">
            <%= image_tag('exit.png', alt: 'Sign out') %>
          </button>
        <% end %>
      </li>
    </ul>
  <% else %>
  <div class="right-buttons">

  <%= form_for "Login", url: omniauth_authorize_path(:user, :google_oauth2), method: :post, data: { turbo: "false" }, html: { class: "button_to" } do |f| %>
          <%= button_tag(type: 'submit', class: 'btn google-btn sign') do %>
          Sign In
          <% end %>
          <% end %>

  <%= form_for "Login", url: omniauth_authorize_path(:user, :google_oauth2), method: :post, data: { turbo: "false" }, html: { class: "button_to" } do |f| %>
      <%= button_tag(type: 'submit', class: 'btn google-btn go-to') do %>
      Go to Spacelector
      <% end %>
      <% end %>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const navLinks = document.querySelectorAll('.nav-link-section');
    const sections = document.querySelectorAll('section'); // Ensure this matches your sections
    let activeLinkIndex = -1;
    let isScrolling = false;

    // Function to remove all 'active' classes
    function removeAllActive() {
      navLinks.forEach((link, index) => {
        link.classList.remove('active');
        if (link.classList.contains('active')) {
          activeLinkIndex = index; // Keep track of the active link
        }
      });
    }

    // Function to set the 'active' class based on current section in viewport
    function setActiveLink() {
      if (isScrolling) return; // Ignore if scrolling is happening due to a click

      let currentActiveIndex = -1;
      sections.forEach((section, index) => {
        const sectionTop = section.offsetTop;
        const sectionHeight = section.clientHeight;
        if (window.pageYOffset >= sectionTop - sectionHeight / 3) {
          currentActiveIndex = index;
        }
      });

      // If the active section index has changed, update the navbar links
      if (currentActiveIndex !== activeLinkIndex) {
        removeAllActive();
        if (currentActiveIndex !== -1) {
          navLinks[currentActiveIndex].classList.add('active');
        }
        activeLinkIndex = currentActiveIndex; // Update the active link index
      }
    }

    // Throttle scroll updates
    let scrollTimeout;
    window.addEventListener('scroll', function() {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(setActiveLink, 100); // Delay updates to reduce sensitivity
    }, false);

    // Smooth scroll to section on navbar item click
    navLinks.forEach((link, index) => {
      link.addEventListener('click', function(event) {
        event.preventDefault(); // Prevent default click behavior
        isScrolling = true; // Set the scrolling flag
        const targetId = link.getAttribute('href').substring(1);
        const targetSection = document.getElementById(targetId);

        // Use the history API to prevent the hash from changing
        history.pushState(null, null, '#' + targetId);

        // Perform the scrolling
        window.scrollTo({
          top: targetSection.offsetTop,
          behavior: 'smooth'
        });

        // Wait for the scrolling to finish, then set the active link
        setTimeout(() => {
          removeAllActive();
          link.classList.add('active');
          activeLinkIndex = index; // Update the active link index
          isScrolling = false; // Reset the scrolling flag
        }, 700); // The timeout should match the scrolling duration
      });
    });
  });
</script>
