<div class="navbar navbar-expand navbar-light navbar-lewagon">
  <%= link_to root_path do %>
    <%= image_tag "spacelector.png", class: "logo" %>
  <% end %>

  <div class="navbar-search-container">
    <%= form_with url: search_spaces_path, method: :get, local: true, class: "search-form" do |form| %>
      <%= form.text_field :query, placeholder: "What are you looking for?", class: "search-input" %>
      <!-- Removed the search button, Enter key will submit the form -->
    <% end %>
  </div>

  <ul class="navbar-nav me-auto">
    <% if user_signed_in? %>
        <a href="<%= checkout_path %>" class="premium-trial">
          <span class="text">Premium Trial</span>
        </a>
          <%= link_to checkout_path, class: "navbar-crown" do %>
            <%= image_tag "crown.png", class: "image-logo" %>
          <% end %>
      <li class="nav-item">
        <%= link_to "Manage billing", @portal_sessions.url unless @portal_session.nil? %>
      </li>
      <li class="nav-item">
        <%= form_with(url: destroy_user_session_path, method: :delete, local: false, class: "form-inline") do %>
          <button type="submit" onclick="return confirm('Are you sure you want to sign out?')" class="btn nav-link sign-out-button">
            <%= image_tag('exit.png', alt: 'Sign out') %>
          </button>
        <% end %>
      </li>
    <% else %>
      <!-- Remove the old Devise login and sign up links -->
      <!-- Display the Google login button -->
      <li class="nav-item">
        <%= form_for "Login", url: omniauth_authorize_path(:user, :google_oauth2), method: :post, data: { turbo: "false" } do |f| %>
          <%= f.submit "Login with Google", type: "image", src: url_for("/assets/google_signin_buttons/web_light_sq_SI@4x.png") %>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
