<!-- app/views/images/new.html.erb -->

<div class="set">
  <div class="header">
    <h1>New Image</h1>
  </div>

  <%= form_with model: @image, url: space_images_path(@space), local: true, class: 'image-form' do |form| %>
    <div class="field">
      <%= form.label :title, 'Title' %>
      <%= form.text_field :title, required: true %>
    </div>

    <div class="field">
      <%= form.label :file, 'Image' %>
      <%= form.file_field :file, required: true, id: 'imageFileInput' %>
    </div>

    <!-- Select Compartments button -->
    <button id="selectCompartmentsButton" type="button" style="display: none;">Select Compartments</button>

    <!-- Canvas for drawing compartments -->
    <canvas id="imageCanvas" style="display: none;"></canvas>

    <!-- Input field for compartment name -->
    <div class="field" style="display: none;">
      <%= form.label :compartment_name, 'Compartment Name' %>
      <%= form.text_field :compartment_name, id: 'compartmentName' %>
    </div>

    <%= form.submit "Upload", class: 'upload-button', id: 'uploadButton' %>
  <% end %>

  <% if @space.parent_space %>
    <%= link_to "Back to '#{j @space.parent_space.name}'",
                space_path(@space.parent_space), class: "back_to" %>
  <% else %>
    <%= link_to 'Back', spaces_path, class: "back" %>
  <% end %>
</div>

<<script>
  // Script to handle image file selection
  document.getElementById('imageFileInput').addEventListener('change', function() {
    const fileInput = this;
    const selectCompartmentsButton = document.getElementById('selectCompartmentsButton');
    const imageCanvas = document.getElementById('imageCanvas');
    const compartmentNameInput = document.getElementById('compartmentName');

    // Show the select compartments button if a file is selected
    if (fileInput.files.length > 0) {
      selectCompartmentsButton.style.display = 'block';
    } else {
      alert('Please choose a file first.');
      selectCompartmentsButton.style.display = 'none';
      imageCanvas.style.display = 'none';
      compartmentNameInput.parentElement.style.display = 'none';
    }
  });

  // Script to initialize the canvas and handle compartment selection
  document.addEventListener('DOMContentLoaded', function() {
    const canvas = document.getElementById('imageCanvas');
    const context = canvas.getContext('2d');
    const compartmentNameInput = document.getElementById('compartmentName');
    const compartments = [];
    let isDrawing = false;
    let startX, startY, endX, endY;

    // Function to draw compartments on the canvas
    function drawCompartments() {
      context.clearRect(0, 0, canvas.width, canvas.height);
      const fileInput = document.getElementById('imageFileInput');
      if (fileInput.files.length > 0) {
        const file = fileInput.files[0];
        const reader = new FileReader();
        reader.onload = function(event) {
          const img = new Image();
          img.onload = function() {
            canvas.width = img.width;
            canvas.height = img.height;
            context.drawImage(img, 0, 0);
            compartments.forEach(compartment => {
              context.beginPath();
              context.rect(compartment.x, compartment.y, compartment.width, compartment.height);
              context.stroke();
              context.fillText(compartment.name, compartment.x, compartment.y - 5);
            });
          };
          img.src = event.target.result;
        };
        reader.readAsDataURL(file);
      }
    }

    // Function to save compartment data
    function saveCompartment() {
      const name = compartmentNameInput.value;
      const width = Math.abs(startX - endX);
      const height = Math.abs(startY - endY);
      compartments.push({ name: name, x: startX, y: startY, width: width, height: height });
      drawCompartments();
    }

    // Mouse event listeners
    canvas.addEventListener('mousedown', function(event) {
      isDrawing = true;
      startX = event.offsetX;
      startY = event.offsetY;
    });

    canvas.addEventListener('mousemove', function(event) {
      if (!isDrawing) return;
      endX = event.offsetX;
      endY = event.offsetY;
      drawCompartments();
      context.beginPath();
      context.rect(startX, startY, endX - startX, endY - startY);
      context.stroke();
    });

    canvas.addEventListener('mouseup', function(event) {
      isDrawing = false;
      saveCompartment();
    });

    // Show canvas and input field when "Select Compartments" button is clicked
    const selectCompartmentsButton = document.getElementById('selectCompartmentsButton');
    selectCompartmentsButton.addEventListener('click', function() {
      const fileInput = document.getElementById('imageFileInput');
      if (fileInput.files.length === 0) {
        alert('Please choose a file first.');
        return;
      }

      drawCompartments();
      canvas.style.display = 'block';
      compartmentNameInput.parentElement.style.display = 'block';
    });
  });
</script>
