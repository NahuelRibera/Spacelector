<section id="content-card" class="set-card">
  <div class='card-general'>
    <h1>Upload Image</h1>
<%# <br> %>
  <%= form_with model: @image, url: space_images_path(@space), local: true, class: 'image-form' do |form| %>
    <div class="field">
      <%= form.label :title, 'Title' %>
      <%= form.text_field :title, required: true, class: 'text-field' %>
    </div>

    <br>

    <div class="field">
      <%# <%= form.label :file, 'Image' %>
      <%= form.file_field :file, required: true, id: 'imageFileInput', capture: 'camera' %>
    </div>

    <br>

    <!-- Select Compartments button -->
    <button id="selectCompartmentsButton" type="button" class="btn back_form">Select Compartments</button>

    <br>

    <!-- Canvas for drawing compartments -->
    <canvas id="imageCanvas" class="image-canvas" style="display: none; max-width: 100%; width: 550px; height: auto; margin-bottom: 20px"></canvas>

    <!-- Container for compartment name input fields -->
    <div id="compartmentNamesContainer" style="display: none;"></div>

    <div class='btn-row'>

  <% if @space.parent_space %>
      <%= link_to "Back to '#{j @space.child_space.name}'", space_path(@space.child_space), class: "back_to" %>
    <% else %>
    <%= link_to 'Back', spaces_path, class: "back_form" %>
      <% end %>
  <%= form.submit "Upload", class:"custom-btn", style: "justify-content: center;", id: 'uploadButton' %>
  </div>
  <% end %>


</div>
</section>

<script>
  // Existing script to handle image file selection
  document.getElementById('imageFileInput').addEventListener('change', function() {
    const fileInput = this;
    const selectCompartmentsButton = document.getElementById('selectCompartmentsButton');
    const imageCanvas = document.getElementById('imageCanvas');

    // Show the select compartments button if a file is selected
    if (fileInput.files.length > 0) {
      selectCompartmentsButton.style.display = 'block';
    } else {
      alert('Please choose a file first.');
      selectCompartmentsButton.style.display = 'none';
      imageCanvas.style.display = 'none';
      compartmentNamesContainer.style.display = 'none';
    }
  });

  // Existing script to initialize the canvas and handle compartment selection
  document.addEventListener('DOMContentLoaded', function() {
    const canvas = document.getElementById('imageCanvas');
    const context = canvas.getContext('2d');
    const compartmentNamesContainer = document.getElementById('compartmentNamesContainer');
    const compartments = [];
    let isDrawing = false;
    let startX, startY, endX, endY;

    // Function to draw compartments on the canvas
    function drawCompartments() {
  const fileInput = document.getElementById('imageFileInput');
  if (fileInput.files.length > 0) {
    const file = fileInput.files[0];
    const reader = new FileReader();
    reader.onload = function(event) {
      const img = new Image();
      img.onload = function() {
        canvas.width = img.width;
        canvas.height = img.height;
        context.clearRect(0, 0, canvas.width, canvas.height); // Clear the canvas first
        context.drawImage(img, 0, 0); // Draw the image

        context.strokeStyle = '#44A0D8'; // Set the stroke color
        context.lineWidth = 4.5; // Set the line width

        compartments.forEach((compartment, index) => {
          context.beginPath();
          context.rect(compartment.x, compartment.y, compartment.width, compartment.height);
          context.stroke();
          context.fillStyle = '#44A0D8'; // Set color to red
          context.font = 'bold 20px Open Sans'; // Set font size and style
          context.fillText((index + 1).toString(), compartment.x + 10, compartment.y + 25); // Draw number
          context.fillText(compartment.name, compartment.x, compartment.y - 5);
        });
      };
      img.src = event.target.result;
    };
    reader.readAsDataURL(file);
  }
}

    // Function to save compartment data
    function saveCompartment() {
      const name = compartmentNamesContainer.lastElementChild.value;
      const width = Math.abs(startX - endX);
      const height = Math.abs(startY - endY);
      const x = Math.min(startX, endX);
      const y = Math.min(startY, endY);
      const compartment = { name, x, y, width, height };

      // Update or create new hidden inputs
      updateOrCreateHiddenInputs(compartment, compartments.length);

      compartments.push(compartment);
      drawCompartments();
    }

    function updateOrCreateHiddenInputs(compartment, index) {
      const form = document.querySelector('.image-form');
      ['name', 'x', 'y', 'width', 'height'].forEach(attr => {
        let input = form.querySelector(`input[name="image[compartments_attributes][${index}][${attr}]"]`);
        if (!input) {
          input = document.createElement('input');
          input.type = 'hidden';
          input.name = `image[compartments_attributes][${index}][${attr}]`;
          form.appendChild(input);
        }
        input.value = compartment[attr];
      });
    }

    // Mouse and touch event listeners
    function handleStart(event) {
      isDrawing = true;
      const rect = canvas.getBoundingClientRect();
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;
      startX = (event.clientX - rect.left) * scaleX;
      startY = (event.clientY - rect.top) * scaleY;

      // Create a new input field for the compartment name with placeholder text
      const input = document.createElement('input');
      input.type = 'text';
      input.placeholder = 'Compartment ' + (compartmentNamesContainer.children.length + 1);
      compartmentNamesContainer.appendChild(input);
    }

    function handleMove(event) {
      if (!isDrawing) return;
      const rect = canvas.getBoundingClientRect();
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;
      endX = (event.clientX - rect.left) * scaleX;
      endY = (event.clientY - rect.top) * scaleY;
      drawCompartments();
      context.beginPath();
      context.rect(startX, startY, endX - startX, endY - startY);
      context.stroke();
    }

    function handleEnd(event) {
      isDrawing = false;
      saveCompartment();
    }

    canvas.addEventListener('mousedown', handleStart);
    canvas.addEventListener('mousemove', handleMove);
    canvas.addEventListener('mouseup', handleEnd);

    canvas.addEventListener('touchstart', function(event) {
      event.preventDefault();
      handleStart(event.touches[0]);
    });

    canvas.addEventListener('touchmove', function(event) {
      event.preventDefault();
      handleMove(event.touches[0]);
    });

    canvas.addEventListener('touchend', handleEnd);

    // Show canvas and input field when "Select Compartments" button is clicked
    const selectCompartmentsButton = document.getElementById('selectCompartmentsButton');
    selectCompartmentsButton.addEventListener('click', function() {
      const fileInput = document.getElementById('imageFileInput');
      if (fileInput.files.length === 0) {
        alert('Please choose a file first.');
        return;
      }

      drawCompartments();
      canvas.style.display = 'block';
      compartmentNamesContainer.style.display = 'block';
    });

    // New event listener to prevent upload if compartments are not named
    const uploadButton = document.getElementById('uploadButton');
    uploadButton.addEventListener('click', function(event) {
      const compartmentInputs = compartmentNamesContainer.querySelectorAll('input');
      let compartmentsNamed = true;

      compartmentInputs.forEach(input => {
        if (input.value.trim() === '') {
          compartmentsNamed = false;
          return;
        }
      });

      if (!compartmentsNamed) {
        event.preventDefault();
        alert('Please name all compartments before uploading.');
      }
    });
  });
</script>
