<section id="content-card" class="set-card">
  <div class='card-general'>
    <h1><%= t('images.title') %></h1>
    <%= form_with model: @image, url: space_images_path(@space), local: true, class: 'image-form' do |form| %>
      <div class="field">
        <%= form.label :title, t('images.label_title') %>
        <%= form.text_field :title, required: true, class: 'text-field' %>
      </div>
      <br>
      <div class="field">
        <%= form.file_field :file, required: true, id: 'imageFileInput' %>
      </div>
      <div id="image-preview-container" style="display: none;">
        <img id="imagePreview" src="#" alt="Image preview" style="max-width: 100%;"/>
      </div>
      <br>
      <div style="display: flex; align-items: center; margin-bottom: 30px;">
        <button id="selectCompartmentsButton" type="button" class="btn back_form" style="margin-right: 10px;"><%= t('images.select_compartments') %></button>
        <button id="resetButton" type="button" class="btn back_form" style="margin-right: 10px;"><%= t('images.reset') %></button>
        <div id="tutorialButton" class="no-style-button">
          <%= image_tag 'question.png', alt: '?', style: 'width: 30px; height: 30px;' %>
        </div>
      </div>
      <canvas id="imageCanvas" class="image-canvas" style="display: none; max-width: 100%; width: 550px; height: auto; margin-bottom: 20px"></canvas>
      <div id="compartmentNamesContainer" style="display: none;"></div>
      <div class='btn-row'>
        <% if @space.parent_space %>
          <%= link_to t('images.back_to', name: j(@space.name)), space_path(@space.parent_space), class: "back_to" %>
        <% else %>
          <%= link_to t('images.back'), spaces_path, class: "back_form" %>
        <% end %>
        <%= form.submit t('images.upload'), class:"custom-btn", style: "justify-content: center;", id: 'uploadButton' %>
      </div>
    <% end %>
  </div>
</section>

<div id="tutorialModal" class="modal">
  <div class="modal-content">
    <span class="close">&times;</span>
    <div class="card-video">
      <%= video_tag "videosp.mp4", controls: true, class: "video-class" %>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const MAX_WIDTH = 1500;
    const MAX_HEIGHT = 1500;
    const canvas = document.getElementById('imageCanvas');
    const context = canvas.getContext('2d');
    const compartmentNamesContainer = document.getElementById('compartmentNamesContainer');
    const imagePreview = document.getElementById('imagePreview');
    const compartments = [];
    let isDrawing = false;
    let startX, startY, endX, endY;
    let selectedFile = null;
    let loadedImage = null;

    document.getElementById('imageFileInput').addEventListener('change', async function(event) {
      selectedFile = event.target.files[0];
      if (selectedFile.type !== 'image/heic') {
        const reader = new FileReader();
        reader.onload = function(e) {
          const img = new Image();
          img.onload = function() {
            let width = img.width;
            let height = img.height;
            
            if (width > MAX_WIDTH || height > MAX_HEIGHT) {
              if (width > height) {
                height = Math.round(height * (MAX_WIDTH / width));
                width = MAX_WIDTH;
              } else {
                width = Math.round(width * (MAX_HEIGHT / height));
                height = MAX_HEIGHT;
              }
            }

            canvas.width = width;
            canvas.height = height;
            context.clearRect(0, 0, canvas.width, canvas.height);
            context.drawImage(img, 0, 0, width, height);
            imagePreview.src = canvas.toDataURL(selectedFile.type);
            imagePreview.style.display = 'block';
          }
          img.src = e.target.result;
        };
        reader.readAsDataURL(selectedFile);
      }
    });

    function drawCompartment(compartment, index) {
      context.beginPath();
      context.rect(compartment.x, compartment.y, compartment.width, compartment.height);
      context.strokeStyle = '#44A0D8';
      context.lineWidth = 11.5;
      context.stroke();
      context.fillStyle = 'black';
      context.font = 'bold 50px Open Sans';
      context.strokeStyle = '#44A0D8';
      context.strokeText((index + 1).toString(), compartment.x + 15, compartment.y + 52);
      context.fillText((index + 1).toString(), compartment.x + 15, compartment.y + 52);
    }

    function drawCompartments(imageSrc) {
      const img = new Image();
      img.onload = function() {
        canvas.width = img.width;
        canvas.height = img.height;
        context.clearRect(0, 0, canvas.width, canvas.height);
        context.drawImage(img, 0, 0);
        loadedImage = img;
        compartments.forEach(drawCompartment);
      };
      if (imageSrc) {
        img.src = imageSrc;
      } else if (loadedImage) {
        context.clearRect(0, 0, canvas.width, canvas.height);
        context.drawImage(loadedImage, 0, 0);
        compartments.forEach(drawCompartment);
      }
    }

    function saveCompartment() {
      const width = Math.abs(startX - endX);
      const height = Math.abs(startY - endY);
      const x = Math.min(startX, endX);
      const y = Math.min(startY, endY);
      const compartment = { x, y, width, height };

      updateOrCreateHiddenInputs(compartment, compartments.length);

      compartments.push(compartment);
      drawCompartments();
    }

    function updateOrCreateHiddenInputs(compartment, index) {
      const form = document.querySelector('.image-form');
      ['x', 'y', 'width', 'height'].forEach(attr => {
        let input = form.querySelector(`input[name="image[compartments_attributes][${index}][${attr}]"]`);
        if (!input) {
          input = document.createElement('input');
          input.type = 'hidden';
          input.name = `image[compartments_attributes][${index}][${attr}]`;
          form.appendChild(input);
        }
        input.value = compartment[attr];
      });
    }

    function disableScroll() {
      document.body.style.overflow = 'hidden';
      document.body.style.height = '100%';
    }

    function enableScroll() {
      document.body.style.overflow = 'auto';
      document.body.style.height = 'auto';
    }

    function handleStart(event) {
      isDrawing = true;
      disableScroll();
      const rect = canvas.getBoundingClientRect();
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;
      startX = (event.clientX - rect.left) * scaleX;
      startY = (event.clientY - rect.top) * scaleY;
    }

    function handleMove(event) {
      if (!isDrawing) return;
      const rect = canvas.getBoundingClientRect();
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;
      endX = (event.clientX - rect.left) * scaleX;
      endY = (event.clientY - rect.top) * scaleY;

      context.clearRect(0, 0, canvas.width, canvas.height);
      context.drawImage(loadedImage, 0, 0, canvas.width, canvas.height);

      compartments.forEach(drawCompartment);

      const currentCompartment = {
        x: Math.min(startX, endX),
        y: Math.min(startY, endY),
        width: Math.abs(endX - startX),
        height: Math.abs(endY - startY)
      };
      drawCompartment(currentCompartment, compartments.length);
    }

    function handleEnd(event) {
      isDrawing = false;
      enableScroll();
      saveCompartment();
    }

    canvas.addEventListener('mousedown', handleStart);
    canvas.addEventListener('mousemove', handleMove);
    canvas.addEventListener('mouseup', handleEnd);

    canvas.addEventListener('touchstart', function(event) {
      event.preventDefault();
      handleStart(event.touches[0]);
    }, { passive: false });

    canvas.addEventListener('touchmove', function(event) {
      event.preventDefault();
      handleMove(event.touches[0]);
    }, { passive: false });

    canvas.addEventListener('touchend', handleEnd);

    const selectCompartmentsButton = document.getElementById('selectCompartmentsButton');
    selectCompartmentsButton.addEventListener('click', async function() {
      if (!selectedFile) {
        alert('Please choose a file first.');
        return;
      }

      if (selectedFile.type === 'image/heic') {
        const formData = new FormData();
        formData.append('file', selectedFile);

        try {
          const response = await fetch('/convert_heic', {
            method: 'POST',
            body: formData,
          });

          if (!response.ok) throw new Error('Server error during conversion.');

          const data = await response.json();
          if (data.preview_url) {
            imagePreview.src = data.preview_url;
            imagePreview.style.display = 'block';
            compartmentNamesContainer.style.display = 'block';
            imagePreview.onload = () => {
              drawCompartments(imagePreview.src);
            }
          } else {
            throw new Error('Invalid server response.');
          }
        } catch (error) {
          console.error('Error uploading and converting HEIC image:', error);
          alert('There was an error processing the HEIC image. Please try again.');
        }
      } else {
        drawCompartments(imagePreview.src);
        compartmentNamesContainer.style.display = 'block';
      }

      canvas.style.display = 'block';
    });

    const resetButton = document.getElementById('resetButton');
    resetButton.addEventListener('click', function() {
      compartments.length = 0; // Clear the compartments array
      context.clearRect(0, 0, canvas.width, canvas.height); // Clear the canvas
      drawCompartments(); // Redraw the image without compartments
      // Optionally clear the hidden inputs
      const form = document.querySelector('.image-form');
      const inputs = form.querySelectorAll('input[name^="image[compartments_attributes]"]');
      inputs.forEach(input => input.remove());
    });

    const uploadButton = document.getElementById('uploadButton');
    uploadButton.addEventListener('click', function(event) {
      const compartmentInputs = compartmentNamesContainer.querySelectorAll('input');
      let compartmentsNamed = true;

      compartmentInputs.forEach(input => {
        if (input.value.trim() === '') {
          compartmentsNamed = false;
          return;
        }
      });

      if (!compartmentsNamed) {
        event.preventDefault();
        alert('Please name all compartments before uploading.');
      }
    });

    var modal = document.getElementById("tutorialModal");

    // Get the button that opens the modal
    var btn = document.getElementById("tutorialButton");

    // Get the <span> element that closes the modal
    var span = document.getElementsByClassName("close")[0];

    // Get the video element
    var video = document.querySelector("#tutorialModal video");

    // When the user clicks the button, open the modal 
    btn.onclick = function() {
      modal.style.display = "block";
    }

    // When the user clicks on <span> (x), close the modal and pause the video
    span.onclick = function() {
      modal.style.display = "none";
      video.pause();
    }

    // When the user clicks anywhere outside of the modal, close it and pause the videos
    window.onclick = function(event) {
      if (event.target == modal) {
        modal.style.display = "none";
        video.pause();
      }
    }
  });
</script>
