<div class="set">
  <div class="header">
    <h1>New Image</h1>
  </div>

  <%= form_with model: @image, url: space_images_path(@space), local: true, class: 'image-form' do |form| %>
    <div class="field">
      <%= form.file_field :file, required: true %>
    </div>
    <%= form.submit "Upload", class: 'upload-button' %>
  <% end %>

  <% if @space.parent_space %>
    <%= link_to "Back to '#{j @space.parent_space.name}'", space_path(@space.parent_space), class: "back_to" %>
  <% else %>
    <%= link_to 'Back', spaces_path, class: "back" %>
  <% end %>
</div>
